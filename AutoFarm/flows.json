        "name": "Light OFF 10PM",
        "props": [{"p": "payload"}, {"p": "topic", "vt": "str"}],
        "repeat": "",
        "crontab": "00 22 * * *",
        "once": false,
        "onceDelay": 0.1,
        "topic": "light",
        "payload": "off",
        "payloadType": "str",
        "x": 150,
        "y": 560,
