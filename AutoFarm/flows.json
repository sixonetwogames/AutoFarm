    {
        "id": "grow-selector",
        "type": "ui_dropdown",
        "z": "hydro-tab",
        "name": "Select Grow",
        "label": "Grow",
        "tooltip": "",
        "place": "Select grow",
        "group": "group-controls",
        "order": 0,
        "width": 6,
        "height": 1,
        "passthru": true,
        "multiple": false,
        "options": [
            {"label": "Grow 1", "value": "grow1", "type": "str"},
            {"label": "Grow 2", "value": "grow2", "type": "str"},
            {"label": "Grow 3", "value": "grow3", "type": "str"}
        ],
        "payload": "",
        "topic": "growId",
        "topicType": "msg",
        "className": "",
        "x": 130,
        "y": 260,
        "wires": [["set-grow-context"]]
    },
    {
        "id": "set-grow-context",
        "type": "change",
        "z": "hydro-tab",
        "name": "Store Grow ID",
        "rules": [{"t": "set", "p": "selectedGrow", "pt": "flow", "to": "payload", "tot": "msg"}],
        "action": "",
        "property": "",
        "from": "",
        "to": "",
        "reg": false,
        "x": 330,
        "y": 260,
        "wires": [[]]
    },
    {
        "id": "format-control-cmd",
        "type": "function",
        "z": "hydro-tab",
        "name": "Format MQTT Command",
        "func": "const growId = flow.get('selectedGrow') || 'grow1';\nconst device = msg.topic;\nconst state = msg.payload;\n\nmsg.topic = `hydro/${growId}/control/${device}`;\nmsg.payload = JSON.stringify({ state: state });\n\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 350,
        "y": 340,
        "wires": [["mqtt-control-out"]]
    },
    {
        "id": "mqtt-control-out",
        "type": "mqtt out",
        "z": "hydro-tab",
        "name": "Send Command",
        "topic": "",
        "qos": "1",
        "retain": "false",
        "respTopic": "",
        "contentType": "",
        "userProps": "",
        "correl": "",
        "expiry": "",
        "broker": "mqtt-broker",
        "x": 580,
        "y": 340,
        "wires": []
    },

    {
        "id": "mqtt-status-in",
        "type": "mqtt in",
        "z": "hydro-tab",
        "name": "Relay Status",
        "topic": "hydro/+/status/relays",
        "qos": "1",
        "datatype": "json",
        "broker": "mqtt-broker",
        "nl": false,
        "rap": true,
        "rh": 0,
        "inputs": 0,
        "x": 130,
        "y": 440,
        "wires": [["update-switch-states"]]
    },
    {
        "id": "update-switch-states",
        "type": "function",
        "z": "hydro-tab",
        "name": "Sync Switch States",
        "func": "const relays = msg.payload;\nconst messages = [];\n\nfor (const [device, state] of Object.entries(relays)) {\n    messages.push({\n        topic: device,\n        payload: state === 'on' ? 'on' : 'off'\n    });\n}\n\nreturn [messages];",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 350,
        "y": 440,
        "wires": [["switch-pump", "switch-light", "switch-fan"]]
    },

    {
        "id": "check-alerts",
        "type": "function",
        "z": "hydro-tab",
        "name": "Alert Thresholds",
        "func": "const thresholds = {\n    ph: { min: 5.5, max: 6.5 },\n    ec: { min: 800, max: 2000 },\n    water_temp: { min: 18, max: 24 },\n    water_level: { min: 20, max: 100 }\n};\n\nconst sensor = msg.sensorType;\nconst value = msg.sensorValue;\nconst t = thresholds[sensor];\n\nif (!t) return null;\n\nif (value < t.min || value > t.max) {\n    return {\n        payload: `⚠️ ${msg.growId}: ${sensor} = ${value.toFixed(1)} (range: ${t.min}-${t.max})`,\n        topic: 'alert'\n    };\n}\n\nreturn null;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 580,
        "y": 240,
        "wires": [["alert-notify"]]
    },
    {
        "id": "alert-notify",
        "type": "ui_toast",
        "z": "hydro-tab",
        "position": "top right",
        "displayTime": "5",
        "highlight": "",
        "sendall": true,
        "outputs": 0,
        "ok": "OK",
        "cancel": "",
        "raw": false,
        "className": "",
        "topic": "",
        "name": "Alert Toast",
        "x": 790,
        "y": 240,
        "wires": []
    },

    {
        "id": "light-scheduler",
