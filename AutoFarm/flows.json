    {
        "id": "timestamp-status",
        "type": "function",
        "z": "hydro-tab",
        "name": "Format Timestamp",
        "func": "const d = new Date();\nmsg.payload = `${msg.growId} | ${msg.sensorType}: ${msg.sensorValue.toFixed(2)} ${msg.sensorUnit} | ${d.toLocaleTimeString()}`;\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 590,
        "y": 340,
        "wires": [["status-text"]]
    },
    {
        "id": "link-to-status",
        "type": "link out",
        "z": "hydro-tab",
        "name": "To Status",
        "mode": "link",
        "links": ["link-from-parse"],
        "x": 515,
        "y": 80,
        "wires": []
    },
    {
        "id": "link-from-parse",
