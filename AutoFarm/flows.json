        "name": "Light ON 6AM",
        "props": [{"p": "payload"}, {"p": "topic", "vt": "str"}],
        "repeat": "",
        "crontab": "00 06 * * *",
        "once": false,
        "onceDelay": 0.1,
        "topic": "light",
        "payload": "on",
        "payloadType": "str",
        "x": 140,
        "y": 520,
        "wires": [["format-control-cmd"]]
    },
