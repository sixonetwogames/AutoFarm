    {
        "id": "mqtt-sensors-in",
        "type": "mqtt in",
        "z": "hydro-tab",
        "name": "All Sensors",
        "topic": "hydro/+/sensors/#",
        "qos": "1",
        "datatype": "json",
        "broker": "mqtt-broker",
        "nl": false,
        "rap": true,
        "rh": 0,
        "inputs": 0,
        "x": 120,
        "y": 80,
        "wires": [["parse-sensor-topic"]]
    },
    {
        "id": "parse-sensor-topic",
        "type": "function",
        "z": "hydro-tab",
        "name": "Parse Topic & Format",
        "func": "const parts = msg.topic.split('/');\nconst growId = parts[1];\nconst sensorType = parts[3];\n\nmsg.measurement = 'sensors';\nmsg.tags = { grow_id: growId, sensor: sensorType };\nmsg.fields = { value: msg.payload.value };\nmsg.growId = growId;\nmsg.sensorType = sensorType;\nmsg.sensorValue = msg.payload.value;\nmsg.sensorUnit = msg.payload.unit || '';\n\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 330,
        "y": 80,
        "wires": [["influx-write", "route-to-gauge", "check-alerts"]]
    },
    {
        "id": "influx-write",
        "type": "influxdb out",
        "z": "hydro-tab",
        "influxdb": "influxdb-config",
        "name": "Write to InfluxDB",
        "measurement": "",
        "precision": "ms",
        "retentionPolicy": "",
        "database": "hydroponics",
        "precisionV18FluxV20": "ms",
        "retentionPolicyV18Flux": "",
        "org": "hydro",
        "bucket": "hydroponics",
        "x": 590,
        "y": 80,
        "wires": []
    },
    {
        "id": "route-to-gauge",
        "type": "switch",
        "z": "hydro-tab",
        "name": "Route by Sensor",
        "property": "sensorType",
        "propertyType": "msg",
        "rules": [
            {"t": "eq", "v": "ph", "vt": "str"},
            {"t": "eq", "v": "ec", "vt": "str"},
            {"t": "eq", "v": "water_temp", "vt": "str"},
            {"t": "eq", "v": "air_temp", "vt": "str"},
            {"t": "eq", "v": "humidity", "vt": "str"},
            {"t": "eq", "v": "water_level", "vt": "str"}
        ],
        "checkall": "false",
        "repair": false,
        "outputs": 6,
        "x": 570,
        "y": 160,
        "wires": [["gauge-ph"], ["gauge-ec"], ["gauge-water-temp"], ["gauge-air-temp"], ["gauge-humidity"], ["gauge-water-level"]]
    },

